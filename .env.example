# ===========================================
# NoteArtist 环境配置
# 复制此文件为 .env 并修改配置
# ===========================================

# ⚠️ 安全警告：生产环境必须修改以下所有默认值！

# ----- 数据库配置 -----
DB_USER=noteartist
DB_PASSWORD=your_strong_db_password_here  # 生产环境必须修改！
DB_NAME=noteartist

# ----- MinIO 对象存储 -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password_here  # 生产环境必须修改！
MINIO_BUCKET=noteartist-images

# ----- JWT 认证 -----
# 生产环境必须设置一个至少 32 字符的随机密钥！
# 可以使用: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_at_least_32_chars_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ----- CORS 配置 -----
# 生产环境应限制为具体域名
CORS_ORIGINS=http://localhost:3000

# ----- 前端配置 -----
REACT_APP_API_URL=http://localhost:8000
REACT_APP_STORAGE_URL=http://localhost:9000

# ----- 安全限制 -----
MAX_IMAGE_SIZE_MB=10
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ----- Redis 配置 (可选) -----
# REDIS_PASSWORD=your_redis_password

# ===========================================
# 生产环境部署清单：
# 1. 修改所有默认密码
# 2. 设置强 JWT_SECRET (至少 32 字符)
# 3. 限制 CORS_ORIGINS 为实际域名
# 4. 移除 docker-compose.yml 中的端口暴露
# 5. 使用 HTTPS
# 6. 配置防火墙规则
# ===========================================
